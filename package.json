{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "zellij",
  "title": "Zellij",
  "description": "Control and manage Zellij terminal multiplexer sessions and layouts",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "license": "MIT",
  "author": "brpaz",
  "contributors": [],
  "pastContributors": [],
  "icon": "icon.png",
  "preferences": [
    {
      "name": "terminalApp",
      "title": "Terminal Application",
      "description": "Choose which terminal application to use when opening Zellij sessions",
      "type": "dropdown",
      "required": true,
      "default": "alacritty",
      "data": [
        {
          "title": "Alacritty",
          "value": "alacritty"
        },
        {
          "title": "Ghostty",
          "value": "ghostty"
        },
        {
          "title": "GNOME Terminal",
          "value": "gnome-terminal"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "list-sessions",
      "title": "List Sessions",
      "description": "List and manage Zellij sessions",
      "mode": "view"
    },
    {
      "name": "list-layouts",
      "title": "List Layouts",
      "description": "List and open Zellij layouts",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "biome check src/ && vici lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@vicinae/api": "^0.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.10",
    "typescript": "^5.9.2"
  }
}
